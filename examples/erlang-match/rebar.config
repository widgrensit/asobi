{erl_opts, [debug_info]}.

%% Hex still publishes 0.35.4, which predates the Lua merge. Pin the tag until
%% 0.51.x ships to Hex, then go back to {asobi, "~> 0.51"}.
{deps, [
    {asobi, {git, "https://github.com/widgrensit/asobi.git", {tag, "v0.51.4"}}}
]}.

{shell, [
    {apps, [erlang_match]},
    {config, "./config/sys.config"}
]}.
