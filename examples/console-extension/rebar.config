{erl_opts, [debug_info]}.

{project_app_dirs, ["apps/*"]}.

{deps, [
    {asobi, "0.74.0"}
]}.

%% Where `rebar3 asobi console` writes the composed bundle. The same name goes
%% in sys.config, which is what makes the node read it: one answers where the
%% build writes, the other what the node serves, and a release can be built on
%% one machine and configured on another.
{asobi, [{console_bundle_app, game_console}]}.

%% `rebar3 asobi check` validates the extension set; `rebar3 asobi console`
%% builds the console. The provider runs from here, but composes the console
%% out of the asobi in `deps` - so the surface these screens compile against is
%% the dependency's, and an exact match between the two is what keeps the
%% provider and that surface from disagreeing.
%%
%% Both are 0.74.0 or newer: the console source only ships in the Hex package,
%% and `rebar3 asobi console` only exists at all, from that release on.
{project_plugins, [
    {asobi, {git, "https://github.com/widgrensit/asobi.git", {tag, "v0.74.0"}}}
]}.

{relx, [
    {release, {console_extension_example, "0.1.0"}, [
        asobi_notes,
        game_console,
        asobi,
        sasl
    ]},
    {mode, prod},
    {sys_config, "./config/sys.config"}
]}.

{shell, [
    {apps, [asobi_notes]},
    {config, "./config/sys.config"}
]}.
