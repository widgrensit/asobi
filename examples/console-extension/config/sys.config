[
    {asobi, [
        {console, true},

        %% Serve the composed bundle from game_console's priv/console rather
        %% than asobi's own. An application named here that is not in the
        %% release makes /console answer 503 and logs bundle_app_unavailable;
        %% it does not fall back to the stock bundle, because a host that asked
        %% for its composed console and silently got the stock one would be
        %% missing exactly the screens it built the thing for.
        {console_bundle_app, game_console},

        %% There is no default credential. Without this the console loads and
        %% admits nobody. Generate one with `openssl rand -hex 32`.
        {ops_secret, <<"replace-me">>},

        {console_label, <<"example">>}
    ]},

    {kura, [
        {repos, [
            #{
                name => asobi_repo,
                adapter => kura_postgres,
                database => "asobi_dev",
                username => "postgres",
                password => "postgres",
                hostname => "localhost",
                port => 5432
            }
        ]}
    ]}
].
