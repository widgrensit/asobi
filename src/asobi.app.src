{application, asobi, [
    {description, "Game backend platform built on Nova/OTP"},
    {vsn, git},
    {registered, []},
    {mod, {asobi_app, []}},
    {included_applications, []},
    {applications, [
        kernel,
        stdlib,
        telemetry,
        nova,
        kura,
        kura_postgres,
        nova_auth,
        nova_auth_oidc,
        nova_resilience,
        shigoto,
        luerl
    ]},
    %% `providers` is read by rebar3 when asobi is listed in a host's
    %% `project_plugins`, and is what makes `rebar3 asobi check` and
    %% `rebar3 asobi console` available. rebar3 looks here before falling back
    %% to a module named after the application, so a provider module needs no
    %% special name.
    {env, [{providers, [rebar3_asobi_check, rebar3_asobi_console]}]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/widgrensit/asobi"}]}
]}.
