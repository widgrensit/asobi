        <<"guides/architecture.md">>,
        <<"guides/benchmarks.md">>,
        <<"guides/glossary.md">>,
        <<"guides/exit.md">>,
        <<"SECURITY.md">>,
        <<"CONTRIBUTING.md">>,
        <<"LICENSE">>
    ]},
    {groups_for_extras, [
        {<<"Getting Started">>, [
            <<"guides/getting-started.md">>,
            <<"guides/lua-scripting.md">>,
            <<"guides/lua-api.md">>,
            <<"guides/lua-bots.md">>,
