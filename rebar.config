            <<"guides/glossary.md">>
        ]},
        {<<"Guides">>, [
            <<"guides/configuration.md">>,
            <<"guides/console.md">>,
            <<"guides/rest-api.md">>,
            <<"guides/websocket-protocol.md">>,
            <<"guides/matchmaking.md">>,
            <<"guides/lobbies.md">>,
            <<"guides/economy.md">>,
            <<"guides/clustering.md">>,
            <<"guides/observability.md">>,
