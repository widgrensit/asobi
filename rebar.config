    ]},
    {groups_for_modules, [
        {<<"Schemas">>, [
            asobi_player,
            asobi_player_stats,
            asobi_match_record,
            asobi_wallet,
            asobi_transaction,
            asobi_item_def,
            asobi_player_item,
